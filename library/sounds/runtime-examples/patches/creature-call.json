{
  "schema": "beeps/patch@1",
  "name": "creature-call",
  "family": "creature",
  "tags": ["voice", "creature"],
  "duration": 0.7,
  "layers": [
    {
      "source": {
        "type": "voice",
        "pitch": 90,
        "formants": [[450, 6, 0], [900, 6, -3], [1800, 5, -10]],
        "tilt": 0.9,
        "jitterCents": 40,
        "tremolo": { "rate": 40, "depth": 0.6 },
        "breath": 0.1
      },
      "pitchEnv": [{ "at": 0.6, "to": 70, "curve": "exp" }],
      "amp": { "attack": 0.06, "decay": 0.5, "sustain": 0.4, "release": 0.15 },
      "filter": { "type": "lowpass", "cutoff": 3200, "resonanceDb": 0 }
    }
  ],
  "variation": { "pitchCents": 25, "gainDb": 1, "variants": 4, "noRepeat": true },
  "xRuntime": {
    "delivery": "both",
    "inputs": {
      "size": { "min": 0, "max": 1, "default": 0.5, "description": "0 small and high .. 1 huge and low; fixed when the call starts" },
      "anger": { "min": 0, "max": 1, "default": 0, "description": "0 calm .. 1 furious; follows the creature while it calls" }
    },
    "bind": [
      { "input": "size", "target": "/out/transpose", "range": [7, -9] },
      { "input": "size", "target": "/out/brightness", "range": [0.5, -0.7] },
      { "input": "anger", "target": "/layers/0/gainDb", "range": [0, 3], "live": true },
      { "input": "anger", "target": "/out/brightness", "range": [0, 0.8], "live": true },
      { "input": "anger", "target": "/out/transpose", "range": [0, 2], "live": true }
    ]
  },
  "meta": { "priority": 3, "intent": "oneshot", "description": "A creature's call from a source-filter voice: size sets its body, anger drives it while it sounds." }
}
