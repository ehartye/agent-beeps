{
  "schema": "beeps/archetype@1",
  "name": "whoosh",
  "family": "whoosh",
  "description": "Swelling wide-band noise whose bandpass centre sweeps upward, over a faint airy hiss",
  "template": {
    "schema": "beeps/patch@1",
    "name": "whoosh",
    "family": "whoosh",
    "archetype": "whoosh",
    "tags": ["motion"],
    "duration": 0.4,
    "layers": [
      {
        "source": { "type": "noise", "color": "white" },
        "amp": { "attack": 0.12, "decay": 0.2, "sustain": 0, "release": 0.1 },
        "filter": {
          "type": "bandpass",
          "cutoff": 500,
          "q": 0.8,
          "env": { "to": 3000, "time": 0.3 }
        }
      },
      {
        "source": { "type": "noise", "color": "white" },
        "gainDb": -24,
        "amp": { "attack": 0.12, "decay": 0.2, "sustain": 0, "release": 0.1 },
        "filter": { "type": "highpass", "cutoff": 4000, "resonanceDb": 0 }
      }
    ],
    "meta": { "priority": 2, "intent": "oneshot" }
  },
  "ranges": {
    "/layers/0/filter/cutoff": { "min": 300, "max": 900, "scale": "log" },
    "/layers/0/filter/env/to": { "min": 1500, "max": 4500, "scale": "log" },
    "/layers/0/filter/env/time": { "min": 0.2, "max": 0.4, "scale": "lin" },
    "/layers/0/filter/q": { "min": 0.5, "max": 1.4, "scale": "log" },
    "/layers/0/amp/attack": { "min": 0.08, "max": 0.2, "scale": "lin" },
    "/layers/1/amp/attack": { "ratioOf": "/layers/0/amp/attack", "choices": [1] },
    "/layers/1/gainDb": { "min": -30, "max": -20, "scale": "lin" }
  }
}
