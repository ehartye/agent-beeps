{
  "schema": "beeps/archetype@1",
  "name": "coin",
  "family": "coin",
  "description": "Classic two-step square/triangle blip that jumps up an in-scale interval",
  "template": {
    "schema": "beeps/patch@1",
    "name": "coin",
    "family": "coin",
    "archetype": "coin",
    "tags": ["repeating", "bright"],
    "duration": 0.3,
    "layers": [
      {
        "source": { "type": "osc", "wave": "square", "pitch": 988 },
        "pitchEnv": [
          { "at": 0.06, "to": 1319, "curve": "step" }
        ],
        "amp": { "attack": 0.004, "decay": 0.22, "sustain": 0, "release": 0.05 },
        "filter": { "type": "lowpass", "cutoff": 6000, "resonanceDb": 0 }
      }
    ],
    "variation": { "pitchCents": 25, "gainDb": 1, "variants": 4, "noRepeat": true },
    "meta": { "priority": 3, "intent": "oneshot" }
  },
  "ranges": {
    "/layers/0/source/pitch": { "min": 700, "max": 1300, "scale": "log" },
    "/layers/0/pitchEnv/0/to": { "ratioOf": "/layers/0/source/pitch", "choices": [1.25, 1.3333, 1.5, 2] },
    "/layers/0/pitchEnv/0/at": { "min": 0.04, "max": 0.09, "scale": "lin" },
    "/layers/0/source/wave": { "choices": ["square", "square", "triangle"] },
    "/layers/0/amp/decay": { "min": 0.12, "max": 0.3, "scale": "log" },
    "/layers/0/filter/cutoff": { "min": 2500, "max": 7000, "scale": "log" }
  }
}
