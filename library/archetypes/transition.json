{
  "schema": "beeps/archetype@1",
  "name": "transition",
  "family": "transition",
  "description": "A scene or menu change: a swell of filtered air with a low body that lands softly",
  "recipe": "Two white-noise layers, a bandpass that sweeps upward over a swelling envelope and a faint highpass hiss, over a sine swell an octave or two below that fades with the noise.",
  "template": {
    "schema": "beeps/patch@1",
    "name": "transition",
    "family": "transition",
    "archetype": "transition",
    "tags": ["motion"],
    "duration": 1,
    "layers": [
      {
        "source": { "type": "noise", "color": "white" },
        "amp": { "attack": 0.4, "decay": 0.45, "sustain": 0, "release": 0.15 },
        "filter": { "type": "bandpass", "cutoff": 400, "q": 0.9, "env": { "to": 2800, "time": 0.7 } }
      },
      {
        "source": { "type": "noise", "color": "white" },
        "gainDb": -24,
        "amp": { "attack": 0.4, "decay": 0.45, "sustain": 0, "release": 0.15 },
        "filter": { "type": "highpass", "cutoff": 4500, "resonanceDb": 0 }
      },
      {
        "source": { "type": "osc", "wave": "sine", "pitch": 110 },
        "gainDb": -10,
        "amp": { "attack": 0.35, "decay": 0.5, "sustain": 0, "release": 0.15 },
        "pitchEnv": [{ "at": 0.8, "to": 165, "curve": "exp" }]
      }
    ],
    "meta": { "priority": 3, "intent": "oneshot" }
  },
  "ranges": {
    "/duration": { "min": 0.6, "max": 1.4, "scale": "lin" },
    "/layers/0/amp/attack": { "ratioOf": "/duration", "min": 0.3, "max": 0.5, "scale": "lin" },
    "/layers/0/amp/decay": { "ratioOf": "/duration", "min": 0.35, "max": 0.5, "scale": "lin" },
    "/layers/0/filter/cutoff": { "min": 250, "max": 700, "scale": "log" },
    "/layers/0/filter/env/to": { "min": 1800, "max": 4500, "scale": "log" },
    "/layers/0/filter/env/time": { "ratioOf": "/duration", "min": 0.6, "max": 0.85, "scale": "lin" },
    "/layers/1/amp/attack": { "ratioOf": "/layers/0/amp/attack", "choices": [1] },
    "/layers/1/amp/decay": { "ratioOf": "/layers/0/amp/decay", "choices": [1] },
    "/layers/2/source/pitch": { "min": 70, "max": 150, "scale": "log" },
    "/layers/2/pitchEnv/0/to": { "ratioOf": "/layers/2/source/pitch", "min": 1.3, "max": 2, "scale": "lin" },
    "/layers/2/gainDb": { "min": -14, "max": -7, "scale": "lin" }
  }
}
