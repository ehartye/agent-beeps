{
  "schema": "beeps/archetype@1",
  "name": "notification",
  "family": "notification",
  "description": "A soft two-note chime that says something arrived, rounder and longer than a confirm",
  "recipe": "Two FM bell notes a fourth or fifth apart with a low modulation index, the second ringing longer, through a small room reverb and held a few dB under a confirm.",
  "template": {
    "schema": "beeps/patch@1",
    "name": "notification",
    "family": "notification",
    "archetype": "notification",
    "tags": ["ui"],
    "duration": 0.5,
    "layers": [
      {
        "source": {
          "type": "fm",
          "pitch": 880,
          "operators": [
            { "ratio": 1, "index": 0 },
            { "ratio": 2, "index": 0.5 }
          ],
          "algorithm": [[1, 0]]
        },
        "amp": { "attack": 0.008, "decay": 0.18, "sustain": 0, "release": 0.06 }
      },
      {
        "source": {
          "type": "fm",
          "pitch": 1174,
          "operators": [
            { "ratio": 1, "index": 0 },
            { "ratio": 2, "index": 0.5 }
          ],
          "algorithm": [[1, 0]]
        },
        "start": 0.12,
        "amp": { "attack": 0.008, "decay": 0.3, "sustain": 0, "release": 0.08 }
      }
    ],
    "fx": { "reverb": { "preset": "small", "sendDb": -24 } },
    "meta": { "priority": 3, "intent": "oneshot", "loudnessOffsetDb": -3 }
  },
  "ranges": {
    "/layers/0/source/pitch": { "min": 600, "max": 1000, "scale": "log" },
    "/layers/1/source/pitch": { "ratioOf": "/layers/0/source/pitch", "choices": [1.3333, 1.5] },
    "/layers/1/start": { "min": 0.09, "max": 0.16, "scale": "lin" },
    "/layers/0/source/operators/1/index": { "min": 0.1, "max": 0.9, "scale": "lin" },
    "/layers/1/source/operators/1/index": { "ratioOf": "/layers/0/source/operators/1/index", "choices": [1] },
    "/layers/0/amp/decay": { "min": 0.12, "max": 0.25, "scale": "log" },
    "/layers/1/amp/decay": { "min": 0.22, "max": 0.4, "scale": "log" }
  }
}
