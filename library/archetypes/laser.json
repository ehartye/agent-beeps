{
  "schema": "beeps/archetype@1",
  "name": "laser",
  "family": "laser",
  "description": "Square or saw zap with a fast exponential pitch drop through a closing lowpass",
  "template": {
    "schema": "beeps/patch@1",
    "name": "laser",
    "family": "laser",
    "archetype": "laser",
    "tags": ["repeating"],
    "duration": 0.2,
    "layers": [
      {
        "source": { "type": "osc", "wave": "square", "pitch": 1500 },
        "pitchEnv": [
          { "at": 0.15, "to": 300, "curve": "exp" }
        ],
        "amp": { "attack": 0.004, "decay": 0.15, "sustain": 0, "release": 0.04 },
        "filter": {
          "type": "lowpass",
          "cutoff": 5000,
          "resonanceDb": 3,
          "env": { "to": 800, "time": 0.15 }
        }
      }
    ],
    "variation": { "pitchCents": 30, "gainDb": 1, "variants": 4, "noRepeat": true },
    "meta": { "priority": 3, "intent": "oneshot" }
  },
  "ranges": {
    "/layers/0/source/pitch": { "min": 800, "max": 2400, "scale": "log" },
    "/layers/0/pitchEnv/0/to": { "ratioOf": "/layers/0/source/pitch", "min": 0.08, "max": 0.35, "scale": "log" },
    "/layers/0/pitchEnv/0/at": { "min": 0.1, "max": 0.2, "scale": "lin" },
    "/layers/0/source/wave": { "choices": ["square", "sawtooth"] },
    "/layers/0/filter/cutoff": { "min": 2500, "max": 8000, "scale": "log" },
    "/layers/0/filter/env/to": { "min": 400, "max": 1500, "scale": "log" },
    "/layers/0/filter/resonanceDb": { "min": 0, "max": 8, "scale": "lin" },
    "/layers/0/amp/decay": { "min": 0.08, "max": 0.16, "scale": "log" }
  }
}
