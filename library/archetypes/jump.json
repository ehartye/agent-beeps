{
  "schema": "beeps/archetype@1",
  "name": "jump",
  "family": "jump",
  "description": "Rising pitch glide, the classic platformer jump",
  "template": {
    "schema": "beeps/patch@1",
    "name": "jump",
    "family": "jump",
    "archetype": "jump",
    "tags": ["repeating"],
    "duration": 0.22,
    "layers": [
      {
        "source": { "type": "osc", "wave": "square", "pitch": 220 },
        "pitchEnv": [
          { "at": 0.18, "to": 550, "curve": "exp" }
        ],
        "amp": { "attack": 0.005, "decay": 0.2, "sustain": 0.3, "release": 0.05 },
        "filter": { "type": "lowpass", "cutoff": 3000, "resonanceDb": 0 }
      }
    ],
    "variation": { "pitchCents": 20, "gainDb": 1, "variants": 4, "noRepeat": true },
    "meta": { "priority": 3, "intent": "oneshot" }
  },
  "ranges": {
    "/layers/0/source/pitch": { "min": 150, "max": 400, "scale": "log" },
    "/layers/0/pitchEnv/0/to": { "ratioOf": "/layers/0/source/pitch", "min": 1.8, "max": 3.2, "scale": "log" },
    "/layers/0/pitchEnv/0/at": { "min": 0.1, "max": 0.2, "scale": "lin" },
    "/layers/0/source/wave": { "choices": ["square", "triangle", "sine"] },
    "/layers/0/filter/cutoff": { "min": 1500, "max": 5000, "scale": "log" },
    "/layers/0/amp/sustain": { "min": 0.1, "max": 0.5, "scale": "lin" }
  }
}
