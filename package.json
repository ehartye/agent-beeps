{
  "name": "agent-beeps",
  "version": "0.30.0",
  "private": true,
  "type": "module",
  "description": "Procedural and recorded-source hybrid game/UI SFX, plus procedural game music for coding agents: editable Web Audio patches and songs, deterministic sample preparation, portable source bundles, verified baked/live delivery, measurements, craft lint and owner auditions with a learned taste model.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "beeps": "scripts/beeps.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.js",
    "showcase:compose": "node scripts/compose-showcase.mjs",
    "showcase:render": "node scripts/render-showcase.mjs",
    "showcase:build": "node scripts/build-showcase.mjs",
    "showcase:test": "node scripts/test-showcase.mjs",
    "showcase:serve": "node scripts/serve-showcase.mjs"
  },
  "dependencies": {
    "commander": "15.0.0",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "@types/node": "26.6.2",
    "rolldown": "1.2.11",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "license": "MIT",
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
